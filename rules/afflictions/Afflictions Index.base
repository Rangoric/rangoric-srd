filters:
  or:
    - and:
        - file.inFolder("rangoric-srd/rules/afflictions")
        - file.hasTag("rangoric/affliction")
    - and:
        - note.affliction-type == "drug"
        - file.inFolder("rangoric-srd/equipment/alchemical-items")
    - and:
        - note.affliction-type == "poison"
        - or:
            - file.inFolder("rangoric-srd/equipment/alchemical-items")
            - file.inFolder("rangoric-srd/equipment/herbs")
views:
  - type: table
    name: All afflictions
    filters:
      and:
        - file.inFolder("rangoric-srd/rules/afflictions")
    order:
      - file.name
      - note.affliction-type
      - note.delivery
      - note.save
      - note.onset
      - note.frequency
      - note.effect
      - note.cure
      - note.price
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Poisons
    filters:
      and:
        - note.affliction-type == "poison"
    groupBy:
      property: note.delivery
      direction: ASC
    order:
      - file.name
      - note.delivery
      - note.save
      - note.onset
      - note.frequency
      - note.effect
      - note.cure
      - note.price
    sort:
      - property: note.delivery
        direction: ASC
      - property: note.save-dc
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Diseases
    filters:
      and:
        - note.affliction-type == "disease"
    order:
      - file.name
      - note.delivery
      - note.save
      - note.onset
      - note.frequency
      - note.effect
      - note.cure
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Curses
    filters:
      and:
        - note.affliction-type == "curse"
    order:
      - file.name
      - note.delivery
      - note.save
      - note.onset
      - note.frequency
      - note.effect
      - note.cure
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Drugs
    filters:
      and:
        - note.affliction-type == "drug"
    order:
      - file.name
      - note.delivery
      - note.addiction
      - note.save
      - note.effect
      - note.damage
      - note.price
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Addictions
    filters:
      and:
        - note.affliction-type == "disease"
        - file.name.endsWith(" Addiction")
    order:
      - file.name
      - note.save
      - note.onset
      - note.frequency
      - note.effect
      - note.cure
    sort:
      - property: note.save
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Infestations
    filters:
      and:
        - note.affliction-type == "infestation"
    order:
      - file.name
      - note.save
      - note.onset
      - note.frequency
      - note.effect
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Insanities
    filters:
      and:
        - note.affliction-type == "insanity"
    order:
      - file.name
      - note.save
      - note.onset
      - note.effect
    sort:
      - property: file.name
        direction: ASC
