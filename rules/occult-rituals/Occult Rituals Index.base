filters:
  and:
    - file.inFolder("rangoric-srd/rules/occult-rituals")
    - note.srd-type == "occult-ritual"
views:
  - type: table
    name: "Occult rituals"
    order:
      - file.name
      - note.level
      - note.school
      - note.casting-time
      - note.status
    sort:
      - property: note.level
        direction: ASC
      - property: file.name
        direction: ASC
