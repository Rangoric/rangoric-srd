filters:
  and:
    - file.inFolder("rangoric-srd/monsters")
views:
  - type: table
    name: "All monsters"
    filters:
      and:
        - file.hasTag("rangoric/monster")
    order:
      - file.name
      - note.size
      - note.creature-type
      - note.subtypes
      - note.challenge-rating
      - note.hit-dice
      - note.armor-class
      - note.environment
      - note.alignment
      - note.group
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "By type"
    filters:
      and:
        - file.hasTag("rangoric/monster")
    groupBy:
      property: note.creature-type
      direction: ASC
    order:
      - file.name
      - note.size
      - note.subtypes
      - note.challenge-rating
      - note.environment
      - note.group
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "By challenge rating"
    filters:
      and:
        - file.hasTag("rangoric/monster")
    groupBy:
      property: note.challenge-rating
      direction: ASC
    order:
      - file.name
      - note.size
      - note.creature-type
      - note.hit-dice
      - note.environment
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Failing
    filters:
      and:
        - note.sweep == "failing"
    order:
      - file.name
      - note.sweep-issues
    sort:
      - property: file.name
        direction: ASC
