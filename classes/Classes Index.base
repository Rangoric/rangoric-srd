filters:
  and:
    - file.inFolder("rangoric-srd/classes")
views:
  - type: table
    name: All notes
    order:
      - file.name
      - srd-type
      - hit-die
      - bab
      - fort
      - ref
      - will
      - alignment
      - skill-points
      - source
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Failing
    filters:
      and:
        - note.sweep == "failing"
    order:
      - file.name
      - note.sweep-issues
    sort:
      - property: file.name
        direction: ASC
