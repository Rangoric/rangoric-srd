filters:
  and:
    - file.inFolder("rangoric-srd/classes")
views:
  - type: table
    name: "All notes"
    order:
      - file.name
      - note.srd-type
      - note.hit-die
      - note.alignment
      - note.skill-points
      - note.source
    sort:
      - property: file.name
        direction: ASC
