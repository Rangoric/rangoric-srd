filters:
  and:
    - file.inFolder("rangoric-srd/feats")
views:
  - type: table
    name: All feats
    filters:
      and:
        - file.hasTag("rangoric/feat")
    order:
      - file.name
      - tags
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: fighter-bonus
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("fighter-bonus")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: item-creation
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("item-creation")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: metamagic
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("metamagic")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: epic
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("epic")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: divine
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("divine")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: wild
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("wild")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: psionic
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("psionic")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: metapsionic
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("metapsionic")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: spelltouched
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("spelltouched")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: hero-feat
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("hero-feat")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: performance
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("performance")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: performance-combat
    filters:
      and:
        - file.hasTag("rangoric/feat")
        - file.hasTag("performance-combat")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Failing
    filters:
      and:
        - note.sweep == "failing"
    order:
      - file.name
      - note.sweep-issues
    sort:
      - property: file.name
        direction: ASC
