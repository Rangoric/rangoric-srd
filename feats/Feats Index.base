filters:
  and:
    - file.inFolder("rangoric-srd/feats")
    - file.hasTag("rangoric/feat")
views:
  - type: table
    name: All feats
    order:
      - file.name
      - tags
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: fighter-bonus
    filters:
      and:
        - file.hasTag("fighter-bonus")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: item-creation
    filters:
      and:
        - file.hasTag("item-creation")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: metamagic
    filters:
      and:
        - file.hasTag("metamagic")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: epic
    filters:
      and:
        - file.hasTag("epic")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: divine
    filters:
      and:
        - file.hasTag("divine")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: wild
    filters:
      and:
        - file.hasTag("wild")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: psionic
    filters:
      and:
        - file.hasTag("psionic")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: metapsionic
    filters:
      and:
        - file.hasTag("metapsionic")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: spelltouched
    filters:
      and:
        - file.hasTag("spelltouched")
    order:
      - file.name
      - prerequisites
    sort:
      - property: file.name
        direction: ASC
