filters:
  and:
    - file.inFolder("rangoric-srd/equipment/alchemical-items")
    - note.srd-type == "alchemical-item"
views:
  - type: table
    name: "All alchemical and herbal items"
    order:
      - file.name
      - note.category
      - note.magical
      - note.cl
      - note.dc
      - note.price
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Alchemical weapons"
    filters:
      and:
        - note.category.contains("Alchemical Weapon")
    order:
      - file.name
      - note.price
      - note.weight
      - note.damage
      - note.range
      - note.critical
      - note.damage-type
      - note.special
      - note.dc
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Fireworks"
    filters:
      and:
        - note.category.contains("Firework")
    order:
      - file.name
      - note.price
      - note.weight
      - note.damage
      - note.range
      - note.dc
    sort:
      - property: file.name
        direction: ASC
