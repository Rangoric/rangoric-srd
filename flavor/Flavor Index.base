filters:
  and:
    - file.inFolder("rangoric-srd/flavor")
    - file.hasTag("flavor")
views:
  - type: table
    name: "All flavor"
    order:
      - file.name
      - file.folder
      - note.place-kind
      - note.region
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: "Places"
    filters:
      and:
        - note.place-kind != null
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - note.place-kind
      - note.region
