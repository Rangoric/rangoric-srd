filters:
  and:
    - file.inFolder("rangoric-srd/flavor")
views:
  - type: table
    name: "All flavor"
    filters:
      and:
        - file.hasTag("flavor")
    order:
      - file.name
      - file.folder
      - note.place-kind
      - note.region
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: "Places"
    filters:
      and:
        - file.hasTag("flavor")
        - note.place-kind != null
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - note.place-kind
      - note.region
  - type: table
    name: "Personalities"
    filters:
      and:
        - file.hasTag("flavor")
        - file.folder.contains("personalities")
    order:
      - file.name
      - file.folder
      - note.wanderer
  - type: table
    name: Failing
    filters:
      and:
        - note.sweep == "failing"
    order:
      - file.name
      - note.sweep-issues
    sort:
      - property: file.name
        direction: ASC
