filters:
  and:
    - file.inFolder("rangoric-srd/skills")
views:
  - type: table
    name: All skills
    filters:
      and:
        - file.hasTag("rangoric/skill")
        - note.status != "replaced"
    order:
      - file.name
      - key-ability
      - trained-only
      - armor-check-penalty
      - source
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Core skills
    filters:
      and:
        - file.hasTag("rangoric/skill")
        - note.status != "replaced"
        - file.hasTag("core")
    order:
      - file.name
      - key-ability
      - trained-only
      - armor-check-penalty
      - source
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Flavor skills
    filters:
      and:
        - file.hasTag("rangoric/skill")
        - note.status != "replaced"
        - file.hasTag("flavor")
    order:
      - file.name
      - key-ability
      - trained-only
      - armor-check-penalty
      - source
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Failing
    filters:
      and:
        - note.sweep == "failing"
    order:
      - file.name
      - note.sweep-issues
    sort:
      - property: file.name
        direction: ASC
