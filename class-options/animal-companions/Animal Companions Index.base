filters:
  and:
    - file.inFolder("rangoric-srd/class-options/animal-companions")
    - note.option-type == "animal companion"
views:
  - type: table
    name: "Animal companions"
    order:
      - file.name
      - note.size
      - note.speed
      - note.advancement-level
    sort:
      - property: file.name
        direction: ASC
