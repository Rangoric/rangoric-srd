filters:
  and:
    - file.inFolder("rangoric-srd/class-options/wild-talents")
views:
  - type: table
    name: "All notes"
    order:
      - file.name
      - note.element
      - note.talent-type
      - note.talent-level
      - note.burn
      - note.book
      - note.status
    sort:
      - property: file.name
        direction: ASC
