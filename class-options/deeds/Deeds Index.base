filters:
  and:
    - file.inFolder("rangoric-srd/class-options/deeds")
views:
  - type: table
    name: "All notes"
    order:
      - file.name
      - note.srd-type
      - note.level
      - note.panache-cost
      - note.book
      - note.status
    sort:
      - property: note.level
        direction: ASC
      - property: file.name
        direction: ASC
