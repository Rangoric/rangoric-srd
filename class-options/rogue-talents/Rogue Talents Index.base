filters:
  and:
    - file.inFolder("rangoric-srd/class-options/rogue-talents")
views:
  - type: table
    name: "All notes"
    order:
      - file.name
      - note.srd-type
      - note.advanced
      - note.sneak-attack
      - note.level
      - note.book
      - note.status
    sort:
      - property: file.name
        direction: ASC
