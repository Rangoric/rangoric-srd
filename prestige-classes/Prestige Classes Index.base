filters:
  and:
    - file.inFolder("rangoric-srd/prestige-classes")
views:
  - type: table
    name: "All notes"
    order:
      - file.name
      - note.srd-type
      - note.hit-die
      - note.bab
      - note.fort
      - note.ref
      - note.will
      - note.alignment
      - note.skill-points
      - note.source
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Failing
    filters:
      and:
        - note.sweep == "failing"
    order:
      - file.name
      - note.sweep-issues
    sort:
      - property: file.name
        direction: ASC
