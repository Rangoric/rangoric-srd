filters:
  and:
    - file.inFolder("rangoric-srd/races/class-bonuses")
views:
  - type: table
    name: "All class bonuses"
    groupBy:
      property: note.race
      direction: ASC
    order:
      - file.name
      - note.race
      - note.class
      - note.book
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Dwarf"
    filters:
      and:
        - note.race == "Dwarf"
    order:
      - file.name
      - note.class
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Elf"
    filters:
      and:
        - note.race == "Elf"
    order:
      - file.name
      - note.class
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Alchemist"
    filters:
      and:
        - note.class.contains("Alchemist")
    order:
      - file.name
      - note.race
    sort:
      - property: file.name
        direction: ASC
  - type: table
