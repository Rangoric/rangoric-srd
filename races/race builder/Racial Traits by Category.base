      - property: file.name
        direction: ASC
  - type: table
    name: Senses Traits
    filters:
      and:
        - file.hasTag("racial-trait/senses")
    order:
      - file.name
      - race-points
      - tags
      - race
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Weakness Traits
    filters:
      and:
        - file.hasTag("racial-trait/weakness")
    order:
      - file.name
      - race-points
      - tags
      - race
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Other Traits
