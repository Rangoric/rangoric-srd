filters:
  and:
    - file.inFolder("rangoric-srd/psionics")
views:
  - type: table
    name: "All notes"
    order:
      - file.name
      - note.srd-type
      - note.bab
      - note.fort
      - note.ref
      - note.will
      - note.source
    sort:
      - property: file.name
        direction: ASC
