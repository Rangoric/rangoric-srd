filters:
  and:
    - file.inFolder("rangoric-srd/magic-items/staffs")
    - file.hasTag("rangoric/magic-item")
formulas:
  gp: number(note.price.replace(",", "").replace(" gp", ""))
views:
  - type: table
    name: All staffs
    order:
      - file.name
      - note.recharge
      - note.price
      - note.caster-level
      - note.aura
      - note.item-type
    sort:
      - property: formula.gp
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Recharging
    filters:
      and:
        - note.recharge == true
    order:
      - file.name
      - note.price
      - note.caster-level
      - note.aura
    sort:
      - property: formula.gp
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Not recharging
    filters:
      and:
        - note.recharge != true
    order:
      - file.name
      - note.price
      - note.caster-level
      - note.aura
      - note.item-type
    sort:
      - property: formula.gp
        direction: ASC
      - property: file.name
        direction: ASC
